    "test": "node --test",
    "migrate:postgres": "node src/scripts/migrate-to-postgres.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "js-yaml": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "ssh2": "^1.16.0",
    "sshpk": "^1.18.0",
    "uuid": "^14.0.1"
  }
