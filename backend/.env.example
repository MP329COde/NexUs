# Port d'écoute de l'API
PORT=4000

# Origine autorisée pour le frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Clé de signature des sessions JWT (obligatoire en production)
JWT_SECRET=changeme-generate-a-long-random-string

# Clé maîtresse pour chiffrer les secrets stockés (tokens API, mots de passe...).
# Si absente, une clé est générée automatiquement dans backend/data/.master.key (usage local uniquement).
# NEXUS_MASTER_KEY=

# Identifiants du compte administrateur initial (créés au premier démarrage si aucun utilisateur n'existe)
ADMIN_EMAIL=admin@homelab.local
ADMIN_PASSWORD=changeme
