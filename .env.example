# Copiez ce fichier en .env avant de lancer `docker compose up -d`.

# Port sur lequel la console est exposée (http://localhost:CONSOLE_PORT)
CONSOLE_PORT=8080

# Obligatoire : générez une valeur longue et aléatoire, par exemple avec
# `openssl rand -hex 32`. Ne jamais utiliser une valeur devinable en production.
JWT_SECRET=

# Optionnel : clé de chiffrement des secrets (tokens API...) en hexadécimal
# 32 octets (openssl rand -hex 32). Si absente, une clé est générée et
# persistée automatiquement dans le volume de données au premier démarrage.
NEXUS_MASTER_KEY=

# Optionnel : si définis, un compte admin est créé automatiquement au premier
# démarrage avec ces identifiants. Sinon, l'assistant de première
# configuration (/setup) s'affiche au premier accès à la console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Obligatoire : mot de passe de la base PostgreSQL du socle organisations /
# équipes / projets / environnements. Générez une valeur longue et aléatoire,
# par exemple avec `openssl rand -hex 24`.
POSTGRES_PASSWORD=
